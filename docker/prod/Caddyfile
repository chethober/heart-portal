# Serves chth.ir directly (no CDN in front) with an automatic Let's Encrypt certificate.
{$SITE_ADDRESS} {
	root * /var/www/html/public
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	# The public disk (hospital logos) lives in the shared storage volume; serve only that folder.
	handle_path /storage/* {
		root * /var/www/html/storage/app/public
		file_server
	}
	php_fastcgi app:9000
	file_server
}
